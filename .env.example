# =============================================================================
# FraudGuard — environment configuration template
# =============================================================================
#
# Copy to .env and fill in local values:   Copy-Item .env.example .env
#
# .env is git-ignored and MUST NEVER be committed.
# This file is the authoritative list of every variable the system reads —
# if you add a variable in code, add it here with a placeholder.
#
# All values below are PLACEHOLDERS. No real secret belongs in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug                        # trace | debug | info | warn | error | fatal
LOG_PRETTY=true                        # human-readable locally; MUST be false in load tests
                                       # (pretty-printing adds hot-path overhead)

# -----------------------------------------------------------------------------
# Services
# -----------------------------------------------------------------------------
FRAUD_API_PORT=3000
REVIEW_API_PORT=3001
ML_SERVICE_PORT=8000
DASHBOARD_PORT=5173

# Explicit V8 heap ceiling. Left unset, V8 sizes against total system memory,
# which on a 7.86 GB machine running the full stack invites the OOM killer.
NODE_MAX_OLD_SPACE_MB=512

# -----------------------------------------------------------------------------
# PostgreSQL — durable state. NEVER read on the hot path (ADR-003).
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost                # container mode: postgres
POSTGRES_PORT=5432
POSTGRES_DB=fraudguard
POSTGRES_USER=fraudguard
POSTGRES_PASSWORD=CHANGE_ME_local_only
POSTGRES_SSL=false

# Separate pools implement the bulkhead in ADR-004: cold-path query load
# cannot exhaust the connections the hot path needs to write decisions.
POSTGRES_POOL_HOT_MAX=10
POSTGRES_POOL_COLD_MAX=5
POSTGRES_STATEMENT_TIMEOUT_MS=100      # hot-path write budget (ADR-003)

# -----------------------------------------------------------------------------
# Redis — hot-path feature store (ADR-002)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost                   # container mode: redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=fg:
REDIS_TIMEOUT_MS=20                    # must stay under the 8ms feature budget + margin
REDIS_MAX_RETRIES=0                    # NO hot-path retries — see ADR-005 on retry storms

# -----------------------------------------------------------------------------
# Kafka — cold path only. Never in the authorization path (ADR-001).
# -----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9094           # host processes (event-worker via `pnpm dev`) use the PLAINTEXT_HOST listener; a containerised process would use kafka:9092
KAFKA_CLIENT_ID=fraudguard
KAFKA_CONSUMER_GROUP=fraudguard-workers
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Single broker locally, so replication.factor must be 1.
# Consequence: broker-loss durability is NOT demonstrable on this hardware.
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1

# -----------------------------------------------------------------------------
# Outbox relay (ADR-006)
# -----------------------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=200            # publication latency vs. DB polling load
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETENTION_HOURS=24              # published rows pruned; audit_events is the durable history

# -----------------------------------------------------------------------------
# Scoring provider (CON-005 — this is how ML is switched on, in Phase 10)
# -----------------------------------------------------------------------------
SCORING_PROVIDER=rules                 # stub | rules | ml — 'rules' is the Phase 5 zero-ML scorer; 'ml' is not implemented until Phase 10
ML_SERVICE_URL=http://localhost:8000   # container mode: http://ml-service:8000
ML_TIMEOUT_MS=30                       # ADR-003 scoring budget
ML_CIRCUIT_BREAKER_THRESHOLD=5         # consecutive failures before opening
ML_CIRCUIT_BREAKER_RESET_MS=10000      # half-open probe delay
ML_FALLBACK_PROVIDER=rules             # ADR-005: what takes over when the breaker opens

# -----------------------------------------------------------------------------
# Risk policy — INITIAL PROTOTYPE VALUES, NOT TUNED.
# Phase 9/11 revise these against measurement. Do not treat as optimal.
# -----------------------------------------------------------------------------
POLICY_VERSION=policy-v1
POLICY_ALLOW_MAX=0.40                  # score <  0.40          -> ALLOW
POLICY_BLOCK_MIN=0.75                  # score >= 0.75          -> BLOCK
                                       # between the two        -> REVIEW

# Degraded thresholds (ADR-005 cautious-open): the REVIEW band widens when
# behavioural features are unavailable, so ambiguity goes to humans rather
# than being approved blind.
POLICY_DEGRADED_ALLOW_MAX=0.25
POLICY_DEGRADED_BLOCK_MIN=0.85

# Score combination weights. Must sum to 1.0.
SCORE_WEIGHT_RULES=0.5
SCORE_WEIGHT_MODEL=0.35
SCORE_WEIGHT_BEHAVIOURAL=0.15

# Rule thresholds (FR-003) — each is an explicit ASSUMPTION, not a
# researched fraud-industry figure (packages/domain's rule files carry
# the same note). Revisit with measurement once demo/load traffic exists.
RULE_VELOCITY_MAX_5M=10
RULE_VELOCITY_MAX_1H=20
RULE_AMOUNT_DEVIATION_MULTIPLIER=5
RULE_DEVICE_MAX_TRANSACTIONS=50
RULE_GEO_MAX_DISTINCT_LOCATIONS_24H=4
RULE_FAILED_MAX_10M=3
RULE_MERCHANT_RISK_THRESHOLD=0.7

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate a real value locally:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=CHANGE_ME_generate_a_random_48_byte_value
AUTH_JWT_ISSUER=fraudguard
AUTH_JWT_AUDIENCE=fraudguard-api
AUTH_TOKEN_TTL_SECONDS=3600

RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX_REQUESTS=100
MAX_CONCURRENT_REQUESTS=500            # load-shedding ceiling; 429 beyond it (ADR-005)

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PATH=/metrics
OTEL_ENABLED=true
OTEL_SERVICE_NAME=fraud-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER_ARG=0.1            # 10% sampling; raise for debugging, lower under load

PROMETHEUS_PORT=9090
GRAFANA_PORT=3030
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_local_only

# -----------------------------------------------------------------------------
# Synthetic data generator (FR-018)
# Same seed => identical event sequence. This is what makes results reproducible.
# -----------------------------------------------------------------------------
SEED=42
GENERATOR_USER_COUNT=10000
GENERATOR_MERCHANT_COUNT=500
GENERATOR_DEVICE_COUNT=15000
GENERATOR_FRAUD_RATE=0.02              # realistic imbalance — accuracy alone is meaningless here

# -----------------------------------------------------------------------------
# Load testing
# -----------------------------------------------------------------------------
K6_TARGET_URL=http://localhost:3000
K6_API_KEY=CHANGE_ME_local_only

# NOTE: on the reference machine the load generator is co-resident with the
# system under test. Results are pessimistic and confounded by CPU contention.
# See docs/DEVELOPMENT_ENVIRONMENT.md 5.2 before reporting any number.
