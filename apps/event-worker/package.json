    "@fraudguard/feature-store": "workspace:*",
    "@fraudguard/messaging": "workspace:*",
    "@fraudguard/observability": "workspace:*",
    "@fraudguard/persistence": "workspace:*",
    "dotenv": "^16.4.7",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
