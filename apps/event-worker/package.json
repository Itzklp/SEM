{
  "name": "@fraudguard/event-worker",
  "version": "0.1.0",
  "private": true,
  "description": "The cold path (ADR-001): outbox relay, audit persistence, feature-update and case-creation Kafka consumers.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
