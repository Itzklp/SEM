{
  "title": "FraudGuard — Golden Signals",
  "uid": "fg-golden-signals",
  "description": "NFR-011: throughput, latency percentiles, error rate and saturation across fraud-api/review-api — the four golden signals, from request_duration_seconds/request_errors_total/active_requests/transactions_total (packages/observability). Phase 7.",
  "tags": ["fraudguard", "golden-signals"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Throughput (requests/sec, by service and route)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(request_duration_seconds_count[1m])) by (route, status_code)",
          "legendFormat": "{{route}} [{{status_code}}]",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency percentiles — /fraud/score (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(request_duration_seconds_bucket{route=\"/api/v1/fraud/score\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(request_duration_seconds_bucket{route=\"/api/v1/fraud/score\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(request_duration_seconds_bucket{route=\"/api/v1/fraud/score\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate (4xx/5xx as a fraction of all responses)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(request_errors_total[5m])) by (route) / sum(rate(request_duration_seconds_count[5m])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active requests (saturation)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "active_requests",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Transactions received (new vs. idempotent replay)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(transactions_total[1m])) by (replay)",
          "legendFormat": "replay={{replay}}",
          "refId": "A"
        }
      ]
    }
  ]
}
