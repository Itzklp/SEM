{
  "title": "FraudGuard — Infrastructure Health",
  "uid": "fg-infra-health",
  "description": "Phase 2 scope only: verifies the observability wiring itself (Prometheus reachable, scrape targets registered). Application dashboards (throughput, decision mix, latency percentiles) are a Phase 7 deliverable, built once fraud-api/event-worker/review-api exist and expose real metrics — see docs/ROADMAP.md.",
  "tags": ["fraudguard", "infrastructure"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Scrape target status (1 = up, 0 = down)",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Prometheus scrape duration by job",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "scrape_duration_seconds",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    }
  ]
}
